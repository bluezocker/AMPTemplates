Meta.DisplayName=Landwirtschafts-Simulator 25 (GIANTS, Docker/Wine)
Meta.Description=Inoffizieller LS25 Dedicated Server unter Linux mit dem offiziellen AMP Wine-Container. GIANTS-Dateien und Aktivierung müssen manuell bereitgestellt werden.
Meta.OS=Linux
Meta.AarchSupport=NotSupported
Meta.Arch=x86_64
Meta.Author=Local
Meta.URL=https://www.farming-simulator.com/
Meta.DisplayImageSource=internal:Generic
Meta.EndpointURIFormat=http://{ip}:{GenericModule.App.Ports.$WebPort}
Meta.ConfigManifest=landwirtschafts-simulator-25-docker-wineconfig.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=landwirtschafts-simulator-25-docker-wine.kvp
Meta.MinAMPVersion=2.6.0.8
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=Der Windows-Dedicated-Server benötigt Wine und Xvfb. Die AMP-Wine-Containerbasis stellt diese Abhängigkeiten bereit.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=2
Meta.ReleaseNotes=Neu auf Basis aktueller offizieller AMP-Wine-Templates aufgebaut.
Meta.BreakingReleaseNotes=
