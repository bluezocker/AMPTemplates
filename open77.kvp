App.WorkingDir=.
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=--no-setup --config open77-amp.jsonc --public-ip "{{PublicIP}}" --port {{$ApplicationPort1}} --max-players {{MaxPlayers}} --name "{{ServerName}}" --visibility {{Visibility}} --log-level info
App.UseLinuxIOREDIR=False
App.AppSettings={"PublicIP":"","ServerName":"OPEN//77 Night City","MaxPlayers":32,"Visibility":"Unlisted","LicenseKey":""}
App.EnvironmentVariables={"OP77_LICENSE_KEY":"{{LicenseKey}}"}
App.CommandLineParameterFormat=-{0} {1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=45
App.ExitString=
App.ExitFile=
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
